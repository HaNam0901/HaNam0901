<script>
	document.addEventListener("DOMContentLoaded", function () {
		// Chọn các phần tử cần thiết
		const minusButton = document.querySelector('.minus');
		const plusButton = document.querySelector('.plus');
		const quantityValue = document.getElementById('quantity_value');

		// Xử lý giảm số lượng
		minusButton.addEventListener('click', function () {
			let currentValue = parseInt(quantityValue.textContent, 10);
			if (currentValue > 1) { // Giới hạn giá trị nhỏ nhất là 1
				currentValue--;
				quantityValue.textContent = currentValue;
			}
		});

		// Xử lý tăng số lượng
		plusButton.addEventListener('click', function () {
			let currentValue = parseInt(quantityValue.textContent, 10);
			currentValue++;
			quantityValue.textContent = currentValue;
		});
	});
</script>
