@model SV21T1020526.DomainModels.Product
@{

}
<section class="section-content bg-white padding-y"style="margin-top:216px">
	<div class="container">

		<!-- ============================ ITEM DETAIL ======================== -->
		<div class="row">
			<aside class="col-md-6">
				<div class="card">
					<article class="gallery-wrap">
						<div class="img-big-wrap">
							<div> <a href="#"><img src="~/images/product/@Model.Photo" style="width:100%;"></a></div>
						</div> <!-- slider-product.// -->
						<div class="thumbs-wrap">
							@foreach(var item in SV21T1020526.BusinessLayers.ProductDataService.ListPhotos(Model.ProductID)){
								<a href="#" class="item-thumb"> <img src="~/images/product/productPhoto/@item.Photo" style="width:100px;"></a>
							}
							
							@* <a href="#" class="item-thumb"> <img src="images/items/15-1.jpg"></a> *@
							@* <a href="#" class="item-thumb"> <img src="images/items/15-2.jpg"></a> *@
							@* <a href="#" class="item-thumb"> <img src="images/items/15-1.jpg"></a> *@
						</div> <!-- slider-nav.// -->
					</article> <!-- gallery-wrap .end// -->
				</div> <!-- card.// -->
			</aside>
			<main class="col-md-6">
				<article class="product-info-aside">

					<h2 class="title mt-3">@Model.ProductName</h2>

				

					<div class="mb-3">
						<var class="price h4">Giá : @Model.Price</var>
						@* <span class="text-muted">USD 562.65 incl. VAT</span> *@
					</div> <!-- price-detail-wrap .// -->

					<p>
						@Model.ProductDescription
					</p>
					<div class="quantity d-flex flex-column flex-sm-row align-items-sm-center">
						<span>Quantity:</span>
						<div class="quantity_selector">
							<span class="minus"><i class="fa fa-minus" aria-hidden="true"></i></span>
							<span id="quantity_value">1</span>
							<span class="plus"><i class="fa fa-plus" aria-hidden="true"></i></span>
						</div>
						<div class="red_button add_to_cart"><a href="#" class="btnAddToCart" data-id="@Model.ProductID">add to cart</a></div>
					</div>

				</article> <!-- product-info-aside .// -->
			</main> <!-- col.// -->
		</div> <!-- row.// -->
		<!-- ================ ITEM DETAIL END .// ================= -->


	</div> <!-- container .//  -->
</section>
