@model IEnumerable<SV21T1020526.DomainModels.Order>
@{
    
}

<div class="container" >
    <h2>@ViewData["Title"]</h2>
        <div style="margin-top:170px; margin-left:200px;margin-right:200px">
    @foreach(var item in Model){
            <div class="card" style="margin-bottom:50px;">
            <div class="card-header" >
                <h5>Thông tin đơn hàng</h5>
            </div>


            <div class="card-body">
                <p><strong>Mã đơn hàng:</strong> @item.OrderID</p>
                <p><strong>Tên người nhận:</strong> @item.CustomerName</p>
                <p><strong>Trạng thái hiện tại:</strong> <span class="badge badge-primary">@item.StatusDescription</span></p>
            </div>
            </div>


    }
        </div>
