@model IEnumerable<CartItem>
@{
    Layout = null;
    int stt = 0;
    decimal sumOfPrice = 0;
}

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr class="bg-primary">
            <th class="text-center">STT</th>
            <th class="text-center">Tên hàng</th>
            <th class="text-center">ĐVT</th>
            <th class="text-center">Số lượng</th>
            <th class="text-center">Giá</th>
            <th class="text-center">Thành tiền</th>
            <th style="width:40px"></th>
        </tr>
    </thead>
    <tbody>
        @if(Model.Count() > 0)
        {
            @foreach(var item in Model)
            {
                sumOfPrice += item.TotalPrice;
                <tr>
                    <td class="text-center">@(++stt)</td>
                    <td>@item.ProductName</td>
                    <td class="text-center">@item.Unit</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-right">@item.SalePrice.ToString("N0")</td>
                    <td class="text-right">@item.TotalPrice.ToString("N0")</td>
                    <td class="text-right">
                        <a href="~/Order/RemoveFromCart/@item.ProductID" 
                            class="btn btn-xs btn-danger ajax-link">
                            <i class="fa fa-minus"></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else{
            <tr>
                <td colspan="7" class="text-center">
                    <p>Giỏ hàng trống</p>
                </td>
            </tr>
        }
        
    </tbody>
    <tfoot>
        <tr>
            <th colspan="5" class="text-right">Tổng cộng:</th>
            <th class="text-right">@sumOfPrice.ToString("N0")</th>
            <th></th>
        </tr>
    </tfoot>
</table>
<div class="text-right">
    <a href="~/Order/ClearCart" class="btn btn-sm btn-danger ajax-link">
        <i class="fa fa-trash"></i> Xóa giỏ hàng
    </a>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.9/jquery.inputmask.min.js"></script>
<script>
    $('.number-separator').inputmask({
        alias: "numeric",
        groupSeparator: ",",       // Dấu phẩy phân cách phần nghìn
        autoGroup: true,           // Tự động thêm dấu phân cách
        digits: 0,                 // Không có chữ số thập phân
        removeMaskOnSubmit: true   // Loại bỏ ký tự phân cách phần nghìn khi submit form
    });
</script>
<script>
    $(document).ready(function () {
        $(".ajax-link").click(function (e) {
            e.preventDefault();

            if(!confirm("Xóa mặt hàng ra khỏi giỏ hàng"))
                return;

            $.ajax({
                url: $(this).prop("href"),
                type: "GET",
                success: function (data) {
                    if (data !== "") {
                        alert(data);
                    }else{
                        showShoppingCart();
                    }
                }
            });
        });
    });
</script>
