@model SV21T1020526.DomainModels.Shipper;
@{
    ViewBag.Title = "Xóa thông tin người giao hàng";
}

<div class="box box-danger">
    <div class="box-body">
        <form method="post" action="~/Shipper/Delete/@Model.shipperId">
            <div class="form-group">
                <label>Tên người giao hàng:</label>
                <p class="form-control form-control-static">@Model.ShipperName</p>

            </div>
            <div class="form-group">
                <label>Điện thoại:</label>
                <p class="form-control form-control-static">@Model.Phone</p>

            </div>
             <div class="form-group text-right">
                
                <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
                    
               
                <a href="~/Shipper" class="btn btn-default">Quay lại</a>


            </div>
        </form>
    </div>
</div>
