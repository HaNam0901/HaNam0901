@model SV21T1020526.DomainModels.Shipper;
@{
    
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Xác nhận xóa người giao hàng</h3>
    </div>
    <div class="box-body">
        <form method="post" action="~/Shipper/Save">
            <input type="hidden" name="@nameof(Model.shipperId)" value="@Model.shipperId" />
            <div class="form-group">
                <label>Tên người giao hàng:</label>
                <input type="text" class="form-control" name="@nameof(Model.ShipperName)" value="@Model.ShipperName">
                @Html.ValidationMessage(nameof(Model.ShipperName))
            </div>
            <div class="form-group">
                <label>Điện thoại:</label>
                <input type="text" class="form-control" name="@nameof(Model.Phone)" value="@Model.Phone" >
                @Html.ValidationMessage(nameof(Model.Phone))
            </div>
            <div class="form-group text-right">

                <button type="submit" class="btn btn-primary">Lưu dữ liệu</button>
                <a href="~/Shipper" class="btn btn-default">Quay lại</a>
            </div>
        </form>
    </div>
</div>
