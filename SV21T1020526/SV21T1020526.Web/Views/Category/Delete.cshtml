@model SV21T1020526.DomainModels.Category
@{
    ViewBag.Title = "Xóa loại hàng";
}

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">Xác nhận xóa loại hàng</h3>
    </div>
    <div class="box-body">
        <form method="post" action="~/Category/Delete/@Model.CategoryId">
            <div class="form-group">
                <label>Tên loại hàng:</label>
                <p class="form-control form-control-static">@Model.CategoryName</p>

            </div>
            <div class="form-group">
                <label>Mô tả:</label>
                <p class="form-control form-control-static">@Model.Description</p>

            </div>
            <div class="form-group text-right">
                
                    <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>

                
                <a href="~/Category" class="btn btn-default">Quay lại</a>
            </div>
        </form>
    </div>
</div>
