@model SV21T1020526.DomainModels.Supplier;
@{
    ViewBag.Title = "Xóa Khách hàng";

}
<div class="box box-danger">
    <div class="box-body">
        <form action="~/Supplier/Delete/@Model.SupplierID" method="post">
            <div class="form-group">
                <label>Tên khách hàng:</label>
                <p class="form-control form-control-static">@Model.SupplierName</p>
            </div>
            <div class="form-group">
                <label>Tên giao dịch:</label>
                <p class="form-control form-control-static">@Model.ContactName</p>

            </div>
            <div class="form-group">
                <label>Điện thoại:</label>
                <p class="form-control form-control-static">@Model.Phone</p>

            </div>
            <div class="form-group">
                <label>Email:</label>
                <p class="form-control form-control-static">@Model.Email</p>

            </div>
            <div class="form-group">
                <label>Địa chỉ:</label>
                <p class="form-control form-control-static">@Model.Address</p>

            </div>

            <div class="form-group">
                <label>Tỉnh thành:</label>
                <p class="form-control form-control-static">@Model.Provice</p>
            </div>
            <div class="form-group text-right">
                
                <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>

                
                <a href="~/Supplier" class="btn btn-default">Quay lại</a>


            </div>
        </form>
    </div>

</div>