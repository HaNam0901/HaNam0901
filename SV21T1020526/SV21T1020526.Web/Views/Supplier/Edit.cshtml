@model SV21T1020526.DomainModels.Supplier;
@{

}
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Supplier/Save" method="post">
            <input type="hidden" name="@nameof(Model.SupplierID)" value="@Model.SupplierID" />
            <div class="form-group">
                <label>Tên Nhà Cung Cấp:</label>
                <input type="text" name="@nameof(Model.SupplierName)" class="form-control"  value="@Model.SupplierName">
                @Html.ValidationMessage(nameof(Model.SupplierName))
            </div>
            <div class="form-group">
                <label>Tên liên hệ:</label>
                <input type="text" name="@nameof(Model.ContactName)" class="form-control"  value="@Model.ContactName">
                @Html.ValidationMessage(nameof(Model.ContactName))

            </div>
            <div class="form-group">
                <label>Điện thoại:</label>
                <input type="text" class="form-control"  name="@nameof(Model.Phone)" value="@Model.Phone">
                @Html.ValidationMessage(nameof(Model.Phone))

            </div>
            <div class="form-group">
                <label>Email:</label>
                <input type="email" name="@nameof(Model.Email)" class="form-control"  value="@Model.Email">
                @Html.ValidationMessage(nameof(Model.Email))

            </div>
            <div class="form-group">
                <label>Địa chỉ:</label>
                <input type="text" class="form-control" name="@nameof(Model.Address)" value="@Model.Address">
                @Html.ValidationMessage(nameof(Model.Address))

            </div>

            <div class="form-group">
                <label>Tỉnh thành:</label>
                <select class="form-control" name="@nameof(Model.Provice)">
                    <option value="">-- chọn tỉnh thành --</option>
                @foreach (var provice in SV21T1020526.BusinessLayers.CommonDataService.ListOfProvinces())
                {
                    if (provice.ProvinceName == Model.Provice)
                    {
                            <option selected value="@provice.ProvinceName">@provice.ProvinceName</option>
                    }
                    else
                    {
                            <option value="@provice.ProvinceName">@provice.ProvinceName</option>

                    }
                };
                </select>
                @Html.ValidationMessage(nameof(Model.Provice))

            </div>

            <div class="form-group text-right">

                <button type="submit" class="btn btn-primary">Lưu dữ liệu</button>

                <a href="~/Supplier" class="btn btn-default">Quay lại</a>


            </div>
        </form>
    </div>

</div>
