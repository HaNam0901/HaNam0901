@model SV21T1020526.Web.Models.PaginationSearchInput
@{
    ViewBag.Title = "Quản lý nhà cung cấp";
}

<div class="box box-primary">
    <div class="box-body">
        <form id="frmSearchInput" action="~/Supplier/Search" method="get">
            <!-- form tìm kiếm -->
            <input type="hidden" name="@nameof(Model.PageSize)" value="@Model.PageSize" />
            <div class="input input-group">
                <input type="text" class="form-control"
                       placeholder="nhập tên khách hàng cần tìm?"
                       name="@nameof(Model.SearchValue)" value="@Model.SearchValue" />
                <div class="input-group-btn">
                    <button class="btn btn-info">
                        <i class="fa fa-search"></i>
                    </button>
                    <a href="~/Supplier/Create" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Bổ sung
                    </a>
                </div>
            </div>
        </form>
        <!-- hiển thị kết quả tìm kiếm -->
        <div id="searchResult"></div>
    </div>
</div>

@section scripts {
    <script>
        function doSearch(page) {
            var searchCondition = $("#frmSearchInput").serializeArray();
            searchCondition.push({ name: "page", value: page });
            var action = $("#frmSearchInput").prop("action");
            var method = $("#frmSearchInput").prop("method");

            $.ajax({
                url: action,
                type: method,
                data: searchCondition,
                success: function (data) {
                    $("#searchResult").html(data);
                }
            });
        }

        $(document).ready(function () {
            doSearch(@Model.Page);
            $("#frmSearchInput").submit(function (e) {
                e.preventDefault();
                doSearch(1);
            });
        });
    </script>
}
